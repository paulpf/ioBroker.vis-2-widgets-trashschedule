{
    "name":  "iobroker.vis-2-widgets-trashschedule",
    "version":  "1.0.5",
    "description":  "Native VIS 2 widget for displaying ioBroker trash schedule data",
    "author":  {
                   "name":  "Paul Pfannschmidt"
               },
    "homepage":  "https://github.com/paulpf/ioBroker.vis-2-widgets-trashschedule",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/paulpf/ioBroker.vis-2-widgets-trashschedule.git"
                   },
    "keywords":  [
                     "ioBroker",
                     "VIS 2",
                     "visualization",
                     "trash",
                     "calendar"
                 ],
    "devDependencies":  {
                            "@alcalzone/release-script":  "^5.1.1",
                            "@alcalzone/release-script-plugin-iobroker":  "^5.1.2",
                            "@alcalzone/release-script-plugin-license":  "^5.1.1",
                            "@iobroker/build-tools":  "^3.0.1",
                            "@iobroker/eslint-config":  "^2.2.0",
                            "@iobroker/types-vis-2":  "^2.13.17",
                            "@iobroker/vis-2-widgets-testing":  "^1.0.6"
                        },
    "main":  "widgets/vis-2-widgets-trashschedule/customWidgets.js",
    "files":  [
                  "admin/",
                  "widgets/",
                  "io-package.json",
                  "LICENSE"
              ],
    "scripts":  {
                    "prepublishOnly":  "node tasks",
                    "lint":  "cd src-widgets-ts \u0026\u0026 eslint -c eslint.config.mjs",
                    "build":  "node tasks --typescript",
                    "build-ts":  "node tasks --typescript",
                    "release":  "release-script",
                    "release-patch":  "release-script patch --yes",
                    "release-minor":  "release-script minor --yes",
                    "release-major":  "release-script major --yes",
                    "test":  "mocha ./test/*.test.js",
                    "update-packages":  "npx -y npm-check-updates --upgrade \u0026\u0026 cd src-widgets-ts \u0026\u0026 npx -y npm-check-updates --upgrade",
                    "npm":  "npm install \u0026\u0026 cd src-widgets-ts \u0026\u0026 npm install"
                },
    "bugs":  {
                 "url":  "https://github.com/paulpf/ioBroker.vis-2-widgets-trashschedule/issues"
             },
    "readmeFilename":  "README.md"
}